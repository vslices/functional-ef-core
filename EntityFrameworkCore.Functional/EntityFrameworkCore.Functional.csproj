<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <VSlicesProjectPath Condition="'$(VSlicesProjectPath)' == '' and Exists('$(MSBuildThisFileDirectory)../../src/VSlices/VSlices.csproj')">$(MSBuildThisFileDirectory)../../src/VSlices/VSlices.csproj</VSlicesProjectPath>
    <VSlicesProjectPath Condition="'$(VSlicesProjectPath)' == ''">$(MSBuildThisFileDirectory)../framework/src/VSlices/VSlices.csproj</VSlicesProjectPath>
    <PackageId>VSlices.EntityFrameworkCore.Functional</PackageId>
    <Authors>Hernán Alvarez; VSlices Development</Authors>
    <Company>VSlices</Company>
    <Description>Functional, effectful Entity Framework Core extensions built on VSlices ForkExt.</Description>
    <PackageTags>entity-framework-core;efcore;functional;forkext;effects;vslices</PackageTags>
    <PackageProjectUrl>https://github.com/vslices/functional-ef-core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vslices/functional-ef-core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(VSlicesProjectPath)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ForkExt" />
    <Using Include="ForkExt.Prelude" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
